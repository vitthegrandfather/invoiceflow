{
  "name": "InvoiceFlow Accounting Sync",
  "description": "Loads a human-approved invoice and requests an idempotent sandbox-ledger sync through the InvoiceFlow API. Transient HTTP failures use bounded node retries; business failures are recorded once for operator review or dead-letter handling.",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "accounting-sync",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1e20000-0000-4000-8000-000000000001",
      "name": "Receive approved ID",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "invoiceflow-sync",
      "credentials": {
        "httpHeaderAuth": {
          "id": "invoiceflow-webhook",
          "name": "InvoiceFlow Webhook"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://api:8000/invoices/{{$json.invoice_public_id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 15000 }
      },
      "id": "a1e20000-0000-4000-8000-000000000002",
      "name": "Read normalized invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "invoiceflow-api", "name": "InvoiceFlow API" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/invoices/{{$json.public_id}}/sync",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Idempotency-Key", "value": "=sync_{{$json.public_id}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({ idempotency_key: 'sync_' + $json.public_id })}}",
        "options": { "timeout": 20000 }
      },
      "id": "a1e20000-0000-4000-8000-000000000003",
      "name": "Create sandbox bill",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "invoiceflow-api", "name": "InvoiceFlow API" }
      }
    },
    {
      "parameters": {
        "jsCode": "const invoice = $input.first().json;\nconst bill = invoice.provider_bill_id;\nif (!bill && invoice.status === 'FAILED') {\n  return [{ json: { ...invoice, dead_letter: true } }];\n}\nreturn [{ json: { ...invoice, stored_provider_id: bill } }];"
      },
      "id": "a1e20000-0000-4000-8000-000000000004",
      "name": "Store provider ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 300],
      "notes": "Normalizes the sandbox API result into delivered or dead-letter state without issuing another provider call."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "id": "failed", "leftValue": "={{$json.status}}", "rightValue": "FAILED", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        }
      },
      "id": "a1e20000-0000-4000-8000-000000000005",
      "name": "Classify delivery result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/workflows/executions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({ workflow: 'accounting-sync', invoice_public_id: $json.public_id, status: $json.status === 'SYNCED' ? 'succeeded' : 'failed', retry_state: $json.dead_letter ? 'dead_letter' : 'none', version: '1.2.1' })}}",
        "options": { "timeout": 15000 }
      },
      "id": "a1e20000-0000-4000-8000-000000000007",
      "name": "Record delivery attempt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "invoiceflow-api", "name": "InvoiceFlow API" }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, recorded: true, demo: true, note: 'Sandbox accounting workflow completed; no live ledger was contacted.' } }}",
        "options": { "responseCode": 200 }
      },
      "id": "a1e20000-0000-4000-8000-000000000010",
      "name": "Respond sync result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1740, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: 'upstream_error', message: $json.error?.message || $json.message || 'InvoiceFlow API request failed' } }}",
        "options": { "responseCode": 502 }
      },
      "id": "a1e20000-0000-4000-8000-000000000011",
      "name": "Respond sync error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1300, 560]
    }
  ],
  "connections": {
    "Receive approved ID": { "main": [[{ "node": "Read normalized invoice", "type": "main", "index": 0 }]] },
    "Read normalized invoice": { "main": [[{ "node": "Create sandbox bill", "type": "main", "index": 0 }], [{ "node": "Respond sync error", "type": "main", "index": 0 }]] },
    "Create sandbox bill": { "main": [[{ "node": "Store provider ID", "type": "main", "index": 0 }], [{ "node": "Respond sync error", "type": "main", "index": 0 }]] },
    "Store provider ID": { "main": [[{ "node": "Classify delivery result", "type": "main", "index": 0 }]] },
    "Classify delivery result": { "main": [[{ "node": "Record delivery attempt", "type": "main", "index": 0 }], [{ "node": "Record delivery attempt", "type": "main", "index": 0 }]] },
    "Record delivery attempt": { "main": [[{ "node": "Respond sync result", "type": "main", "index": 0 }], [{ "node": "Respond sync error", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false },
  "tags": [{ "name": "invoiceflow" }]
}
