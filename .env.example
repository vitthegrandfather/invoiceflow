# InvoiceFlow fictional placeholders only. Do not put live credentials here.
# Copy to a local untracked file if you run Docker — never commit secrets.

DATABASE_URL=postgresql+asyncpg://invoiceflow:invoiceflow_demo@localhost:5432/invoiceflow
REDIS_URL=redis://localhost:6379/0

ACCOUNTING_PROVIDER=sandbox
EXTRACTION_PROVIDER=sandbox
NOTIFICATION_PROVIDER=sandbox
OBJECT_STORAGE_PROVIDER=sandbox

